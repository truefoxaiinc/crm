{
 "doctype": "DocType",
 "name": "CRM Project",
 "module": "FCRM",
 "autoname": "format:PRJ-{#####}",
 "title_field": "project_name",
 "default_view": "List",
 "allow_import": 1,
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": [
  "project_name", "status", "priority", "progress", "project_manager",
  "start_date", "expected_end_date", "section_break_relationships",
  "lead", "deal", "contact", "organization", "section_break_description",
  "description"
 ],
 "fields": [
  {"fieldname": "project_name", "fieldtype": "Data", "label": "Project Name", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Planned\nIn Progress\nOn Hold\nCompleted\nCancelled", "default": "Planned", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Low\nMedium\nHigh", "default": "Medium", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "progress", "fieldtype": "Percent", "label": "Progress", "default": 0, "in_list_view": 1},
  {"fieldname": "project_manager", "fieldtype": "Link", "label": "Project Manager", "options": "User", "in_list_view": 1},
  {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date", "in_list_view": 1},
  {"fieldname": "expected_end_date", "fieldtype": "Date", "label": "Expected End Date", "in_list_view": 1},
  {"fieldname": "section_break_relationships", "fieldtype": "Section Break", "label": "Related CRM Records"},
  {"fieldname": "lead", "fieldtype": "Link", "label": "Lead", "options": "CRM Lead", "in_standard_filter": 1},
  {"fieldname": "deal", "fieldtype": "Link", "label": "Deal", "options": "CRM Deal", "in_standard_filter": 1},
  {"fieldname": "contact", "fieldtype": "Link", "label": "Contact", "options": "Contact", "in_standard_filter": 1},
  {"fieldname": "organization", "fieldtype": "Link", "label": "Organization", "options": "CRM Organization", "in_standard_filter": 1},
  {"fieldname": "section_break_description", "fieldtype": "Section Break", "label": "Description"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "share": 1},
  {"role": "Sales Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "share": 1},
  {"role": "Sales User", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "share": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
